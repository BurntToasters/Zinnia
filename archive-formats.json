  "asymmetries": [
    {
      "layer": "frontendArchiveExtensions",
      "formats": ["tar-gz", "tar-bz2", "tar-xz"],
      "note": "Compound forms are not listed. isArchiveFile uses endsWith, so .tar.gz is caught by .gz."
    },
    {
      "layer": "frontendArchiveExtensions",
      "formats": ["split-volume"],
      "note": "Frontend isArchiveFile does not treat .001 as an archive. Split sets reach Zinnia through the picker and Rust routing."
    },
    {
      "layer": "openRouting",
      "formats": ["tar-gz", "tar-bz2", "tar-xz"],
      "note": "Compound forms are not listed. endsWith on .gz/.bz2/.xz covers them. The split-volume check is separate (splitVolumeDetection)."
    },
    {
      "layer": "openRouting",
      "formats": ["rar"],
      "note": "ARCHITECTURE.md says .rar routing is Windows-only. open_routing.rs has no platform gate, so .rar is routed on every OS. This records the code."
    },
    {
      "layer": "fileAssociation",
      "formats": ["tar-gz", "tar-bz2", "tar-xz"],
      "note": "OS file associations use the short forms (.tgz/.tbz2/.txz). Compound .tar.* extensions are not registered."
    },
    {
      "layer": "fileAssociation",
      "formats": ["split-volume"],
      "note": "No OS file association for .001 on any platform. Windows reaches split sets through the NSIS and Win11 verbs and the shell DLL."
    },
    {
      "layer": "fileAssociationBase",
      "formats": ["rar"],
      "note": "Base tauri.conf.json omits .rar. Each platform file replaces the whole array (Tauri merges arrays by replacement) and includes .rar, so the base list is not used on a supported OS."
    },
    {
      "layer": "windowsProgIdOpenVerb",
      "formats": ["rar", "tgz", "tbz2", "txz", "split-volume"],
      "note": "The NSIS ProgId macro writes the 'Open with Zinnia' label only for the six classic formats."
    },
    {
      "layer": "finderSyncArchiveExtensions",
      "formats": ["tgz", "tbz2", "txz"],
      "note": "Not in the Set. They match only through the compoundTarSuffixes hasSuffix list in isArchiveURL."
    },
    {
      "layer": "finderSyncArchiveExtensions",
      "formats": ["tar-gz", "tar-bz2", "tar-xz"],
      "note": "Not in the Set. pathExtension is gz/bz2/xz, which is in the Set, so they route as gzip/bzip2/xz."
    },
    {
      "layer": "splitBaseSuffixes",
      "formats": ["rar", "tar-gz", "tar-bz2", "tar-xz", "tgz", "tbz2", "txz"],
      "note": "Base names with these suffixes are not accepted before a numeric volume suffix. RAR has its own part/legacy rules in the same file."
    },
    {
      "layer": "createOutput",
      "formats": [
        "rar",
        "tgz",
        "tbz2",
        "txz",
        "tar-gz",
        "tar-bz2",
        "tar-xz",
        "split-volume"
      ],
      "note": "Not creatable. RAR cannot be created with 7-Zip, and compound TAR output is rejected (compoundTarSuffixes)."
    },
    {
      "layer": null,
      "formats": ["tgz", "tbz2", "txz", "tar-gz", "tar-bz2", "tar-xz"],
      "note": "detectFamily is null. archive_detect.rs has no explicit arm for these. The generic arm accepts any known signature or tar, so no family check runs."
    }
  ]
}
