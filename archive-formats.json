{
  "schemaVersion": 1,
  "description": "Canonical archive format list. Each layer is one hand-maintained list in the tree; scripts/check-archive-formats.mjs compares them. Membership true means the list contains the format's extension(s) or MIME on that platform. 'all' values are shorthand for all three platforms. A per-platform object is written only when platforms differ.",
  "layers": {
    "frontendArchiveExtensions": {
      "description": "src/utils.ts ARCHIVE_EXTENSIONS (isArchiveFile): frontend 'is this an archive' check."
    },
    "basicPickerExtensions": {
      "description": "src/basic/wire.ts BASIC_ARCHIVE_EXTENSIONS: file dialog filter (no leading dot; includes 001)."
    },
    "openRouting": {
      "description": "src-tauri/src/launch/open_routing.rs looks_like_archive_extension: launch/open routing."
    },
    "splitVolumeDetection": {
      "description": "Functional split-volume (.001) detection markers: open_routing.rs, dllmain.cpp, FinderSync.swift."
    },
    "extractFolderSuffixes": {
      "description": "Suffixes stripped to derive an extract folder name (open_path.rs SUFFIXES, extract-path.ts). Longest first."
    },
    "compoundTarSuffixes": {
      "description": "Compound TAR suffixes: rejected as create output and treated as streams for list/test (Rust + args.ts) and macOS Finder Sync."
    },
    "finderSyncArchiveExtensions": {
      "description": "macOS FinderSync.swift archiveExtensions Set (single-extension matches)."
    },
    "windowsShellArchiveExtensions": {
      "description": "Windows shell extension dllmain.cpp LooksLikeArchiveExtension kExts."
    },
    "windowsClassicArchiveVerbs": {
      "description": "NSIS classic Extract verbs (register, legacy cleanup, uninstall unregister)."
    },
    "windowsProgIdOpenVerb": {
      "description": "NSIS ZINNIA_REGISTER_PROGID_OPEN: 'Open with Zinnia' label on the ProgId open verb."
    },
    "win11ExtractMenuItemTypes": {
      "description": "Windows 11 sparse package ExtractAppxManifest.xml.template desktop5:ItemType entries."
    },
    "fileAssociation": {
      "description": "Per-platform bundle.fileAssociations (tauri.windows/macos/linux.conf.json). MIME must match."
    },
    "fileAssociationBase": {
      "description": "Base src-tauri/tauri.conf.json bundle.fileAssociations (not used on supported OSes; see asymmetries)."
    },
    "linuxMimeTypes": {
      "description": "Linux MIME type lists: run.rosie.zinnia.desktop, linux/desktop-template.hbs, metainfo mediatype entries."
    },
    "defaultHandlerTargets": {
      "description": "src-tauri/src/platform/mod.rs ARCHIVE_DEFAULT_TARGETS: 'set default app' targets (extension + MIME)."
    },
    "splitBaseSuffixes": {
      "description": "archive_snapshot.rs KNOWN_ARCHIVE_SUFFIXES: base names accepted before a numeric split suffix."
    },
    "createOutput": {
      "description": "src/archive/args.ts OUTPUT_SUFFIXES: formats the app can create."
    }
  },
