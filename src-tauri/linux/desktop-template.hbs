[Desktop Entry]
Type=Application
Name={{name}}
Exec={{exec}} %F
Icon={{icon}}
Categories={{categories}}
Terminal=false
MimeType=application/x-7z-compressed;application/zip;application/x-tar;application/gzip;application/x-bzip2;application/x-xz;application/vnd.rar;
{{#if comment}}
Comment={{comment}}
{{/if}}
Actions=Open;Extract;Compress;

[Desktop Action Open]
Name=Open with Zinnia
Exec={{exec}} %F

[Desktop Action Extract]
Name=Extract with Zinnia
Exec={{exec}} --extract %F

[Desktop Action Compress]
Name=Compress with Zinnia
Exec={{exec}} --compress %F
