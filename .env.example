# GitHub personal access token (repo scope): used to create releases & upload assets
GH_TOKEN=

# GPG key ID / fingerprint for signing release artifacts
GPG_KEY_ID=

# GPG passphrase for non-interactive (CI) signing
GPG_PASSPHRASE=

# Tauri updater signing (from `tauri signer generate`):
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode signing via Azure Artifact Signing (Public Trust)
# Once per Windows release VM (as Administrator), run: npm run setup:win:artifact-signing
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Required for every Windows signature check and the Win11 context menu MSIX:
# exact signing cert Subject DN
# (must match Azure Artifact Signing profile Subject name). Example:
#   AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=CN=Your Name, O=Your Org, C=US
# Tip after a signed build:
#   (Get-AuthenticodeSignature .\zinnia.exe).SignerCertificate.Subject
AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0
# Skip building/signing the Win11 modern context-menu package (classic verbs remain).
# SKIP_WIN_CONTEXT_MENU=1
# Optional overrides if Client Tools are installed in a nonstandard location:
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=

# macOS codesigning & notarization (used by Tauri automatically):
# Certificate identity from Keychain (e.g. "Developer ID Application: Name (TEAMID)")
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
SSH_USER_PWD=

# Optional: mirror cleaned `release/` artifacts to another folder after finalize step.
# Use an absolute path outside this repository, for example Z:/ZINNIA on Windows
# or /Volumes/releases/ZINNIA on macOS. Linux should use its mounted share path.
AFTER_PACK_LOC=Z:/ZINNIA

# Override repo owner/name (defaults to BurntToasters/zinnia)
# GH_REPO_OWNER=BurntToasters
# GH_REPO_NAME=zinnia
