#!/bin/sh
# Zinnia pre-commit gate. Enabled via `git config core.hooksPath .githooks`
# (set automatically by `npm install` through the prepare script).
# Bypass with: git commit --no-verify

set -e

run_npm() {
  # Git hooks run under sh on Windows; route through cmd.exe so we never hit
  # the POSIX npm shim in "C:\Program Files\nodejs\npm".
  if [ "${OS:-}" = "Windows_NT" ] && command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe //d //c npm.cmd "$@"
  elif command -v npm.cmd >/dev/null 2>&1; then
    npm.cmd "$@"
  else
    npm "$@"
  fi
}

# Only run JS tooling when staged files touch the frontend/tooling surface.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|css|html)$'; then
  echo "pre-commit: prettier --check"
  run_npm run --silent format:check
  echo "pre-commit: eslint"
  run_npm run --silent lint
  echo "pre-commit: tsc --noEmit"
  run_npm run --silent typecheck
fi

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^src-tauri/.*\.rs$|^src-tauri/Cargo\.(toml|lock)$|^src-tauri/(tauri.*\.conf\.json|capabilities/.*\.json)$|^archive-formats\.json$'; then
  echo "pre-commit: cargo fmt --check"
  cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check
  echo "pre-commit: archive-formats check"
  run_npm run --silent check:archive-formats
fi
